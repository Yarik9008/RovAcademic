# Map each firmware tree to its PlatformIO compile_commands.json (clangd).
# With "." listed first in a multi-root workspace, editor can pick the wrong root; this keeps flags correct.
If:
  PathMatch: .*[\\/]control_system[\\/].*
CompileFlags:
  CompilationDatabase: control_system

---
If:
  PathMatch: .*[\\/]gamepad[\\/].*
CompileFlags:
  CompilationDatabase: gamepad

---
If:
  PathMatch: .*[\\/]gripper[\\/].*
CompileFlags:
  CompilationDatabase: gripper
